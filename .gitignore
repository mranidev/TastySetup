# MariesRestaurant-style .gitignore for Wasmer Edge deployment
# Vendor is committed so Wasmer's Git deploy (no build step) ships a
# self-contained app — `wasmer deploy` uses the local copy as-is.

.DS_Store
.idea
.env.testing
.phpunit.result.cache

node_modules

/public/vendor
/public/storage

/storage/clockwork
/_ide_helper.php

storage/logs/*.log
storage/framework/cache/data/*
storage/framework/cache/*.php

# Local runtime data — never commit
.freebuff/
